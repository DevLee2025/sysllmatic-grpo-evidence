#!/usr/bin/env bash
#SBATCH --job-name=grpo-smoke
#SBATCH --account=scholar
#SBATCH --partition=gpu
#SBATCH --constraint=a40
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --time=01:00:00
#SBATCH --output=grpo-smoke-%j.out

set -euo pipefail
readonly SUBMIT_DIR="${SLURM_SUBMIT_DIR:?submit this job from the grpo_smoke directory}"
bash "${SUBMIT_DIR}/run_scholar_gpu.sh"
