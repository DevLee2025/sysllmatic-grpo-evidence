{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysllmatic.local/schemas/attempt-record-v1.json",
  "title": "SysLLMatic candidate attempt record",
  "type": "object",
  "required": [
    "schema_version",
    "attempt_id",
    "created_at_utc",
    "task",
    "model",
    "generation",
    "candidate",
    "evaluation",
    "environment"
  ],
  "properties": {
    "schema_version": {"const": "sysllmatic.attempt.v1"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "task": {
      "type": "object",
      "required": ["id", "benchmark", "language", "source_sha256", "description", "hardware", "interface", "constraints"]
    },
    "model": {
      "type": "object",
      "required": ["provider", "id", "revision", "adapter_path", "adapter_manifest_sha256", "dtype", "device"]
    },
    "generation": {
      "type": "object",
      "required": [
        "status",
        "decoding_strategy",
        "device_policy",
        "do_sample",
        "seed",
        "max_new_tokens",
        "num_return_sequences",
        "prompt_contract_sha256",
        "input_tokens",
        "output_tokens",
        "elapsed_seconds"
      ]
    },
    "candidate": {
      "type": "object",
      "required": ["path", "sha256", "raw_completion_path", "raw_completion_sha256", "extraction"]
    },
    "evaluation": {
      "type": "object",
      "required": ["compilation", "execution", "correctness", "timing", "feedback"],
      "properties": {
        "compilation": {"$ref": "#/$defs/runStatus"},
        "execution": {"$ref": "#/$defs/runStatus"},
        "correctness": {"type": "object"},
        "timing": {"type": "object"},
        "feedback": {"type": "object"}
      }
    },
    "environment": {"type": "object"}
  },
  "$defs": {
    "runStatus": {
      "type": "object",
      "required": ["status", "exit_code", "elapsed_seconds", "log"],
      "properties": {
        "status": {"enum": ["not_run", "passed", "failed", "timeout", "error"]},
        "exit_code": {"type": ["integer", "null"]},
        "elapsed_seconds": {"type": ["number", "null"]},
        "log": {"type": ["string", "null"]}
      }
    }
  }
}
